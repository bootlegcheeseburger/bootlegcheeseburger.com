#!/bin/bash
# A push deploys (Cloudflare Pages), so a drifted EULA, contact page or "Free!"
# sticker never leaves this Mac: every pushed commit must pass
# scripts/eula-check.py, scripts/contact-check.py and scripts/free-check.py.
# Called by the shop dispatcher (~/Code/blc/hooks/_dispatch) after its own checks.
set -uo pipefail
top="$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
fail=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue   # a branch deletion pushes no tree
  python3 -I "$top/scripts/eula-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/contact-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/free-check.py" --rev "$lsha" || fail=1
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: drift from ~/Code/store; push refused (it would deploy). Fix, commit, push again." >&2
  exit 1
fi
exit 0
