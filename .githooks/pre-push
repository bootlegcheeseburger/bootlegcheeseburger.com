#!/bin/bash
# A push deploys (Cloudflare Pages), so a secret or uncatalogued app, or a drifted
# EULA, contact page, "Free!" ribbon or eyebrow, license sentence, price label or
# price id never leaves this Mac: every pushed commit must pass
# scripts/apps-check.py, scripts/eula-check.py, scripts/contact-check.py,
# scripts/free-check.py, scripts/license-check.py and scripts/price-check.py.
# Called by the shop dispatcher after its own checks. The scripts find the store
# checkout through STORE_REPO (scripts/store_path.py); outside just, it comes from
# the shared recipes' export via `just --evaluate`.
set -uo pipefail
top="$(git rev-parse --show-toplevel)" || exit 1
[ -n "${STORE_REPO:-}" ] || export STORE_REPO="$(just -f "$top/justfile" --evaluate STORE_REPO 2>/dev/null)"
zero=0000000000000000000000000000000000000000
fail=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue   # a branch deletion pushes no tree
  python3 -I "$top/scripts/apps-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/eula-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/contact-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/free-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/license-check.py" --rev "$lsha" || fail=1
  python3 -I "$top/scripts/price-check.py" --rev "$lsha" || fail=1
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: drift from the store checkout (STORE_REPO); push refused (it would deploy). Fix, commit, push again." >&2
  exit 1
fi
exit 0
